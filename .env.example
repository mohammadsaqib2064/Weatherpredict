# WeatherPredict — environment configuration
# Copy to .env and adjust. MongoDB is the only data store.

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=weatherpredict

# Cache TTLs (seconds) for console aggregates and analytics results
DASHBOARD_CACHE_SECONDS=45
ANALYTICS_CACHE_SECONDS=300

# Real-time layer: how often the live fragment re-reads MongoDB
REALTIME_POLL_SECONDS=5

# Optional site-wide banner (scheduled maintenance notice)
# MAINTENANCE_MESSAGE=Scheduled maintenance 02:00–03:00 UTC. Writes paused.

